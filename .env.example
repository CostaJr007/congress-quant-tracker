# CongressQuantTracker - Environment Variables
# Copy this file to .env and fill in your values

# Database (PostgreSQL preferred, SQLite fallback)
# PostgreSQL:
DATABASE_URL=postgresql://user:password@localhost:5432/congress_quant_tracker
# SQLite (uncomment to use):
# DATABASE_URL=sqlite:///congress_quant_tracker.db

# Anthropic / Claude API
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: Custom API base URL (for proxies / compatible endpoints)
# ANTHROPIC_BASE_URL=https://api.doxio.ai/v1

# Optional: LLM model choice
LLM_MODEL=claude-3-5-sonnet-20241022

# Optional: Data directories
DATA_DIR=./data
PDF_DOWNLOAD_DIR=./data/pdfs

# Optional: Update settings
MAX_PDF_PAGES=200
FETCH_TIMEOUT_SECONDS=120
PARSE_BATCH_SIZE=10

# Groq LLM for PTR extraction (https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Tavily search for ticker resolve + news filters (https://tavily.com)
TAVILY_API_KEY=

# Set 1 to always use Groq even when regex finds trades
# LLM_ENABLED=0
