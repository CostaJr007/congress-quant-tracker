# CongressQuantTracker - Environment Variables
# Copy this file to .env and fill in your values. NEVER commit .env

# Database (SQLite is fine for local dev)
DATABASE_URL=sqlite:///congress_quant_tracker.db
# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/congress_quant_tracker

# Market data (yfinance) — charts, returns leaderboard, trade enrich
MARKET_DATA_ENABLED=1
# Scorer-only: skip yfinance in scoring path (terminal can still use MARKET_DATA)
NO_YF=0

# Anthropic / Claude (optional PDF path)
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
LLM_MODEL=claude-3-5-sonnet-20241022

# Groq LLM for PTR extraction (https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (optional Copilot provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local OpenAI-compatible LLM (optional)
LOCAL_LLM_URL=http://127.0.0.1:8080/v1

# Tavily search (https://tavily.com)
TAVILY_API_KEY=

# Discord alerts for new / flagged trades (optional)
DISCORD_WEBHOOK_URL=

# Optional HTTPS proxy for Senate eFD (CONNECT required)
# HTTP_PROXY=http://host:port

# Data directories
DATA_DIR=./data
PDF_DOWNLOAD_DIR=./data/pdfs
MAX_PDF_PAGES=200
# Auto-sync on startup (1 = enabled, 0 = disabled)
AUTO_SYNC_ON_STARTUP=1
STARTUP_SYNC_DAYS=90
STARTUP_SYNC_MAX=60

# API bind address (127.0.0.1 = local only; 0.0.0.0 exposes on the LAN)
API_HOST=127.0.0.1
API_PORT=8000

