# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment / secrets
.env
.env.*
!.env.example
*.env.local

# Database
*.db
*.sqlite3
*.sqlite

# Runtime data & caches (repo-root only — not kimi_gmt_terminal/js/data)
/data/
/pdfs/
**/cache/

# Virtual env
.venv/
venv/

# Node / Next.js
node_modules/
.next/
out/
.turbo/
npm-debug.log*
yarn-error.log*
package-lock.json
# keep package-lock for reproducible builds of web_fused
!web_fused/package-lock.json

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# Streamlit secrets
.streamlit/secrets.toml

# Scrapes / clones / junk
disclose_clone/
# Root-only junk (do NOT use bare D*/ — that ignores every folder named data/)
/D*/
clone_*.py
run_*clone*.bat
*_check*.py
/_*.py
/_*.html
/_*.pdf

# Deliverable zips / external dumps (source lives in kimi_gmt_terminal/)
*.zip
/global-market-terminal-final/
**/market-dashboard/

# Local logs
*.log


# Large legacy frontend deps live under web/node_modules (ignored above)
web/.next/
# Photos live only under web_fused (avoid duplicating ~48MB from legacy web/)
web/public/politicians/

# uv
uv.lock
